# Lemon Squeezy webhook (Vercel → medical-science project)
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Admin page /api/admin-grant — invente uma password longa (só para vocês)
ADMIN_GRANT_SECRET=your-long-random-admin-secret

# Vercel Web Analytics (painel /admin/stats.html) — token em vercel.com/account/tokens
# Team ID e Project ID: Vercel Dashboard → Settings do projecto / equipa
VERCEL_ACCESS_TOKEN=your-vercel-api-token
VERCEL_TEAM_ID=team_xxxxxxxx
VERCEL_PROJECT_ID=prj_xxxxxxxx
# Opcional: dias de histórico (1–90, default 7)
# VERCEL_ANALYTICS_DAYS=7

# Firebase client (página /acesso/) — mesmas chaves das apps
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=studio9-medical.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studio9-medical
VITE_FIREBASE_APP_ID=your-app-id

# Progress dashboard (repo Progress, Vercel progress-azure-five) — same Firebase keys as above

# Firebase Admin — service account JSON (single line) from Firebase console
# Project settings → Service accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"studio9-medical",...}
