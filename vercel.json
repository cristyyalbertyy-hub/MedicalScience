{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/acesso", "destination": "/conta/index.html" },
    { "source": "/acesso/", "destination": "/conta/index.html" },
    { "source": "/conta", "destination": "/conta/index.html" },
    { "source": "/contacto", "destination": "/contacto/index.html" },
    { "source": "/contacto/", "destination": "/contacto/index.html" },
    { "source": "/curriculo", "destination": "/packages/" },
    { "source": "/curriculo/", "destination": "/packages/" },
    { "source": "/italian-health-system", "destination": "/italian-health-system/" },
    {
      "source": "/italian-health-system/(IHS[^/]*\\.(?:mp4|m4a|png|csv))",
      "destination": "https://italian-health-system.vercel.app/$1"
    },
    {
      "source": "/(human-anatomy-1|medical-biology|genetics|physics|information-processing|statistics|histology|embryology|histology-embryology|chemistry|introductory-biochemistry|chemistry-introductory-biochemistry|history-of-medicine|moral-philosophy|health-technology-assessments)/?",
      "destination": "/apps/launcher.html"
    }
  ],
  "headers": [
    {
      "source": "/app.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/italian-health-system/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/packages/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
