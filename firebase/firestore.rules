rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function entitlementDoc(userId, packageId) {
      return /databases/$(database)/documents/entitlements/$(userId + '_' + packageId);
    }

    function hasActiveEntitlement(packageId) {
      let ent = get(entitlementDoc(request.auth.uid, packageId));
      return ent != null
        && ent.data.user_id == request.auth.uid
        && ent.data.package_id == packageId;
    }

    function validWatchCount() {
      return request.resource.data.watch_count == null
        || (request.resource.data.watch_count is int
            && request.resource.data.watch_count >= 0
            && request.resource.data.watch_count <= 3);
    }

    function validManualLevel() {
      return request.resource.data.manual_level == null
        || (request.resource.data.manual_level is int
            && request.resource.data.manual_level >= 0
            && request.resource.data.manual_level <= 3);
    }

    match /entitlements/{docId} {
      allow read: if isSignedIn()
        && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /progress/{docId} {
      function isOwnProgressDoc() {
        return docId.matches('^' + request.auth.uid + '_.*');
      }

      // getDoc on a not-yet-created doc has resource == null; must allow before first watch.
      allow get: if isSignedIn()
        && isOwnProgressDoc()
        && (
          resource == null
          || (
            resource.data.user_id == request.auth.uid
            && hasActiveEntitlement(resource.data.package_id)
          )
        );

      allow list: if isSignedIn()
        && resource.data.user_id == request.auth.uid
        && hasActiveEntitlement(resource.data.package_id);

      allow create, update: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.package_id is string
        && request.resource.data.item_key is string
        && request.resource.data.resource is string
        && request.resource.data.status in ['started', 'completed']
        && hasActiveEntitlement(request.resource.data.package_id)
        && validWatchCount()
        && validManualLevel();

      allow delete: if false;
    }
  }
}
