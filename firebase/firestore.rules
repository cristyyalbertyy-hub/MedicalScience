rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /entitlements/{docId} {
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }
  }
}

// Studio9 Medical Science — Firebase Auth (email link) + Firestore entitlements
// Packages: medical-biology, genetics
//
// Firebase console setup:
// 1. Create project (separate from Supabase)
// 2. Authentication → Sign-in method → Email/Password → enable Email link
// 3. Authentication → Settings → Authorized domains:
//    biology-genetics.vercel.app
//    medica-genetics.vercel.app
// 4. Firestore → create database → deploy these rules
// 5. Composite index (Firestore prompts on first query):
//    entitlements: user_id ASC, package_id ASC
//
// Grant access manually after purchase (Firestore → entitlements → Add document):
//   user_id:     <Firebase Auth UID>
//   package_id:  medical-biology | genetics | ...
//   expires_at:  2027-06-23T00:00:00.000Z   (ISO string, 1 year from purchase)
//
// Automatic grants: POST /api/lemonsqueezy-webhook (Firebase Admin SDK, bypasses rules)
// Idempotency: collection orders_processed (admin write only)
//
// Vercel env vars (Biology + Genetics):
//   VITE_FIREBASE_API_KEY
//   VITE_FIREBASE_AUTH_DOMAIN
//   VITE_FIREBASE_PROJECT_ID
//   VITE_FIREBASE_APP_ID
//   VITE_PACKAGE_ID = medical-biology | genetics
//   VITE_STORE_URL = https://medical-science-lilac.vercel.app/precos/
