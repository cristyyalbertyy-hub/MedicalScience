rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function validWatchCount() {
      return !('watch_count' in request.resource.data)
        || (request.resource.data.watch_count is number
            && request.resource.data.watch_count >= 0
            && request.resource.data.watch_count <= 3);
    }

    function validManualLevel() {
      return !('manual_level' in request.resource.data)
        || (request.resource.data.manual_level is number
            && request.resource.data.manual_level >= 0
            && request.resource.data.manual_level <= 3);
    }

    function allowedProgressPackage(packageId) {
      return packageId in [
        'human-anatomy-1',
        'medical-biology',
        'genetics',
        'physics',
        'information-processing',
        'statistics',
        'histology',
        'embryology',
        'histology-embryology',
        'chemistry',
        'introductory-biochemistry',
        'chemistry-introductory-biochemistry',
        'history-of-medicine',
        'moral-philosophy',
        'health-technology-assessments',
        'italian-health-system'
      ];
    }

    match /entitlements/{docId} {
      allow get: if isSignedIn()
        && (resource == null || resource.data.user_id == request.auth.uid);

      allow list: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      allow write: if false;
    }

    match /progress/{docId} {
      function isOwnProgressDoc() {
        return docId.matches('^' + request.auth.uid + '_.*');
      }

      allow get: if isSignedIn()
        && (resource == null
            ? isOwnProgressDoc()
            : resource.data.user_id == request.auth.uid);

      allow list: if isSignedIn()
        && resource.data.user_id == request.auth.uid;

      // Writes: trust user_id on the document (doc id prefix check blocked valid client writes).
      allow create, update: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && allowedProgressPackage(request.resource.data.package_id)
        && request.resource.data.item_key is string
        && request.resource.data.resource is string
        && request.resource.data.status in ['started', 'completed']
        && validWatchCount()
        && validManualLevel();

      allow delete: if false;
    }
  }
}
